# ===========================================
# Financial Report Generator - 환경변수 설정
# ===========================================

# Anthropic API
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# Claude 모델 설정
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# Database
# 개발 환경 (SQLite)
DATABASE_URL=sqlite:///./data/app.db

# 프로덕션 환경 (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/finreport

# Redis (Optional - Caching)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Application Settings
APP_ENV=development  # development, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# File Upload Settings
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,docx,txt,html
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports

# Analysis Settings
DEFAULT_ANALYSIS_DEPTH=standard  # quick, standard, deep
ENABLE_PEER_ANALYSIS=true
MAX_PEER_COMPANIES=5

# Report Settings
DEFAULT_TEMPLATE=default  # default, professional
REPORT_LANGUAGE=ko  # ko, en
INCLUDE_CHARTS=true

# API Rate Limiting (Optional)
API_RATE_LIMIT=100  # requests per minute
API_TIMEOUT=300  # seconds

# Security
SECRET_KEY=your-secret-key-for-session-management
ALLOWED_HOSTS=localhost,127.0.0.1

# Monitoring (Optional)
SENTRY_DSN=
ENABLE_MONITORING=false

# Cache Settings
CACHE_TTL_HOURS=24
ENABLE_PROMPT_CACHING=true  # Claude Prompt Caching

# OCR Settings (Tesseract)
TESSERACT_CMD=/usr/bin/tesseract  # or C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=kor+eng

# External APIs (Optional)
YAHOO_FINANCE_ENABLED=false
ALPHA_VANTAGE_API_KEY=
